export function age(row: TokenRow) {
  const start = firstValue(row, ["block_time", "created_at", "launch_time"]);
  if (!start) return null;

  const diff = Date.now() - new Date(start).getTime();
  if (diff < 0) return null;

  const hours = Math.floor(diff / 3600000);
  if (hours < 24) return `${hours}h`;

  const days = Math.floor(hours / 24);
  if (days < 30) return `${days}d`;

  const months = Math.floor(days / 30);
  return `${months}mo`;
}

export function trendScore(row: TokenRow): number | null {
  return hotScore(row);
}

export function activityScore(row: TokenRow): number {
  const buysCount = numeric(row, ["buys", "buy_count", "buys_24h", "buyCount"]) ?? 0;
  const sellsCount = numeric(row, ["sells", "sell_count", "sells_24h", "sellCount"]) ?? 0;
  const trades = numeric(row, ["trades_24h", "trade_count", "trades", "tx_count", "transactions"]) ?? 0;
  const holdersCount = numeric(row, ["holders"]) ?? 0;

  const activity = buysCount + sellsCount + trades;

  const score =
    Math.min(100, (Math.log10(1 + activity) / Math.log10(10000)) * 70) +
    Math.min(30, (Math.log10(1 + holdersCount) / Math.log10(1000)) * 30);

  return Math.round(score);
}


export function badgeType(row: TokenRow): string {
  const score = hotScore(row);
  const volume = radarVolume(row) ?? 0;
  const badges: string[] = [];

  const buys = numeric(row, [
    "buys",
    "buy_count",
    "buys_24h",
    "buyCount"
  ]) ?? 0;

  const sells = numeric(row, [
    "sells",
    "sell_count",
    "sells_24h",
    "sellCount"
  ]) ?? 0;

  const holders = numeric(row, [
    "holders"
  ]) ?? 0;

  const trades = numeric(row, [
    "trades_24h",
    "trade_count",
    "trades",
    "tx_count",
    "transactions"
  ]) ?? 0;

  const total = buys + sells;

  const buyPressure =
    total > 0
      ? buys / total
      : 0;


  // Large liquidity analysis
  if (
    volume >= 1000000 &&
    buyPressure >= 0.60
  ) {
    badges.push("WHALE");
  } 
  else if (
    volume >= 1000000 &&
    buyPressure >= 0.50
  ) {
    badges.push("WHALE WATCH");
  }


  // Market health
  if (
    volume >= 100000 &&
    buyPressure >= 0.65 &&
    holders >= 100
  ) {
    badges.push("HEALTHY");
  }


  // Selling pressure warning
  if (
    volume >= 100000 &&
    buyPressure < 0.45
  ) {
    badges.push("RISK");
  }


  // Activity
  if (
    score >= 45 ||
    trades >= 100
  ) {
    badges.push("ACTIVE");
  }


  // New launch
  const start = firstValue(row, [
    "block_time",
    "created_at",
    "launch_time",
  ]);

  if (start) {
    const days =
      (Date.now() - new Date(start).getTime()) / 86400000;

    if (days <= 7) {
      badges.push("NEW");
    }
  }


  return badges.join(" ");
}

export function hotScore(row: TokenRow): number {
  const volume = radarVolume(row) ?? 0;
  const volume24 = volume24h(row) ?? 0;

  const buys = numeric(row, [
    "buys",
    "buy_count",
    "buys_24h",
    "buyCount"
  ]) ?? 0;

  const sells = numeric(row, [
    "sells",
    "sell_count",
    "sells_24h",
    "sellCount"
  ]) ?? 0;

  const trades = numeric(row, [
    "trades_24h",
    "trade_count",
    "trades",
    "tx_count",
    "transactions"
  ]) ?? 0;

  const holdersCount = numeric(row, [
    "holders"
  ]) ?? 0;

  const tokenAge = age(row);

  const totalTrades = buys + sells;

  const buyPressure =
    totalTrades > 0
      ? buys / totalTrades
      : 0;


  // Volume strength 30%
  const volumeScore = Math.min(
    30,
    (Math.log10(1 + volume) / Math.log10(10000000)) * 30
  );


  // Buyer strength 35%
  const pressureScore =
    Math.min(
      35,
      buyPressure * 35
    );


  // Activity 15%
  const activityScore =
    Math.min(
      15,
      (Math.log10(1 + trades + buys + sells) / Math.log10(10000)) * 15
    );


  // Holder confidence 10%
  const holderScore =
    Math.min(
      10,
      (Math.log10(1 + holdersCount) / Math.log10(1000)) * 10
    );

    // Age confidence 10%
    let ageScore = 0;

    if (tokenAge) {
      if (tokenAge.includes("mo")) ageScore = 10;
      else if (tokenAge.includes("d")) ageScore = 8;
      else if (tokenAge.includes("h")) ageScore = 5;
    }



  // Sell pressure penalty -10%
  let sellPenalty = 0;

  if (buyPressure < 0.50) {
    sellPenalty = 10;
  } else if (buyPressure < 0.60) {
    sellPenalty = 5;
  }

  if (volume24 <= 0 && trades <= 0) {
    return 0;
  }


  return Math.max(
    0,
    Math.round(
      volumeScore +
      pressureScore +
      activityScore +
        holderScore +
        ageScore -
      sellPenalty
    )
  );
}
