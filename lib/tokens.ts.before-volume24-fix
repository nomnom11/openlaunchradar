  const buyPressure =
    total > 0 ? buys / total : 0;


  if (volume >= 100000) {
    reasons.push("Strong 24h volume");
  }

  if (buyPressure >= 0.55) {
    reasons.push("Positive buy pressure");
  }

  if (buys >= 1000) {
    reasons.push("High buyer activity");
  }

  if (holdersCount >= 100) {
