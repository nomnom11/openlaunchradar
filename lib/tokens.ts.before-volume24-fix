export function qualityScore(row: TokenRow): number {
  const volume24 = volume24h(row) ?? 0;
  const volume = radarVolume(row) ?? 0;

  const buys = numeric(row, [
    "buys",
    "buy_count",
    "buys_24h",
    "buyCount"
  ]) ?? 0;

  const sells = numeric(row, [
    "sells",
    "sell_count",
    "sells_24h",
    "sellCount"
  ]) ?? 0;

  const holdersCount = numeric(row, [
    "holders"
  ]) ?? 0;

  const totalTrades = buys + sells;

  const buyPressure =
    totalTrades > 0
      ? buys / totalTrades
      : 0;

  const volumeScore = Math.min(
    40,
    (Math.log10(1 + volume24) / Math.log10(1000000)) * 40
  );

  const pressureScore =
    Math.min(25, buyPressure * 25);

  const holderScore =
    Math.min(
      20,
      (Math.log10(1 + holdersCount) / Math.log10(1000)) * 20
    );

  const liquidityScore =
    Math.min(
      15,
      (Math.log10(1 + volume) / Math.log10(10000000)) * 15
    );

  let penalty = 0;

  if (volume24 < 100) penalty -= 30;

  if (totalTrades < 50) penalty -= 20;

  if (buyPressure < 0.4 && totalTrades > 0) {
    penalty -= 15;
  }

  return Math.round(
    volumeScore +
    pressureScore +
    holderScore +
    liquidityScore +
    penalty
  );
}


export function confidenceScore(row: TokenRow): number {
  const volume24 = volume24h(row) ?? 0;
  const buysCount = numeric(row, [
    "buys",
    "buy_count",
    "buys_24h",
    "buyCount"
  ]) ?? 0;

  const sellsCount = numeric(row, [
    "sells",
    "sell_count",
    "sells_24h",
    "sellCount"
  ]) ?? 0;

  const holdersCount = numeric(row, [
    "holders"
  ]) ?? 0;

  let score = 0;


  // Real 24h activity
  if (volume24 >= 10000) score += 30;
  else if (volume24 >= 1000) score += 20;
  else if (volume24 > 0) score += 10;


  // Trading activity
  const trades = buysCount + sellsCount;

  if (trades >= 5000) score += 25;
  else if (trades >= 500) score += 15;
  else if (trades >= 50) score += 8;


  // Holder quality
  if (holdersCount >= 500) score += 25;
  else if (holdersCount >= 100) score += 15;
  else if (holdersCount >= 20) score += 8;


  // Buy pressure
  if (trades > 0) {
    const pressure = buysCount / trades;

    if (pressure >= 0.6) score += 20;
    else if (pressure >= 0.5) score += 10;
  }


  return Math.min(100, score);
}


export function volumeSpikeScore(
  row: TokenRow,
  previousVolume: number = 0
): number {

  const current = volume24h(row) ?? 0;

  if (!previousVolume || previousVolume <= 0) {
    return 0;
  }

  const change =
    ((current - previousVolume) / previousVolume) * 100;

  if (change >= 300) return 100;
  if (change >= 200) return 80;
  if (change >= 100) return 60;
  if (change >= 50) return 40;

  return 0;
}


export function spikeLabel(
  row: TokenRow,
  previousVolume: number = 0
): string {

  const score = volumeSpikeScore(row, previousVolume);

  if (score >= 80) return "SPIKE";
  if (score >= 40) return "RISING";

  return "";
}


export function buyAccelerationScore(
  row: TokenRow,
  previousBuys: number = 0
): number {

  const buys = numeric(row, [
    "buys",
    "buy_count",
    "buys_24h",
    "buyCount"
  ]) ?? 0;


  if (!previousBuys || previousBuys <= 0) {
    return 0;
  }


  const growth =
    ((buys - previousBuys) / previousBuys) * 100;


  if (growth >= 300) return 100;
  if (growth >= 200) return 80;
  if (growth >= 100) return 60;
  if (growth >= 50) return 40;


  return 0;
}


export function flowSignal(row: TokenRow): string {
  const buys = numeric(row, [
    "buys",
    "buy_count",
    "buys_24h",
    "buyCount"
  ]) ?? 0;

  const sells = numeric(row, [
    "sells",
    "sell_count",
    "sells_24h",
    "sellCount"
  ]) ?? 0;

  const total = buys + sells;

  if (total === 0) return "";

  const pressure = buys / total;

  if (pressure >= 0.70) return "STRONG BUY FLOW";
  if (pressure >= 0.55) return "BUY PRESSURE";
  if (pressure >= 0.45) return "NEUTRAL";
  if (pressure >= 0.35) return "SELL PRESSURE";

  return "STRONG SELL FLOW";
}


export function earlyEntryScore(row: TokenRow): number {
  const confidence = confidenceScore(row);
  const volumeSpike = volumeSpikeScore(row);
  const flow = flowSignal(row);

  let score = confidence * 0.4;
  score += volumeSpike * 0.3;

  if (flow === "STRONG BUY FLOW") score += 30;
  else if (flow === "BUY PRESSURE") score += 15;
  else if (flow === "SELL PRESSURE") score -= 15;
  else if (flow === "STRONG SELL FLOW") score -= 30;

  return Math.max(0, Math.min(100, Math.round(score)));
}


export function radarScore(row: TokenRow): number {

  const quality = qualityScore(row);
  const confidence = confidenceScore(row);
  const momentum = momentum24h(row);
  const early = earlyEntryScore(row);

  const buys = numeric(row, [
    "buys",
    "buy_count",
    "buys_24h",
    "buyCount"
  ]) ?? 0;

  const sells = numeric(row, [
    "sells",
    "sell_count",
    "sells_24h",
    "sellCount"
  ]) ?? 0;


  const trades = buys + sells;

  const buyPressure = trades > 0
    ? (buys / trades) * 100
    : 0;


  let score =
    quality * 0.30 +
    confidence * 0.10 +
    momentum * 0.25 +
    early * 0.15 +
    buyPressure * 0.20;


  return Math.max(0, Math.min(100, Math.round(score)));
}


export function radarLabel(row: TokenRow): string {
  const score = radarScore(row);

  if (score >= 85) return "ELITE";
  if (score >= 70) return "STRONG";
  if (score >= 55) return "WATCH";

  return "RISK";
}

export function whyToken(row: TokenRow): string[] {
  const reasons: string[] = [];

  const volume = volume24h(row) ?? 0;
  const holderCount = holders(row) ?? 0;
  const tokenAge = age(row);

  const buysCount = buys(row) ?? 0;
  const totalTrades = tradeCount(row) ?? 0;

  const buyPressure =
    totalTrades > 0
      ? (buysCount / totalTrades) * 100
      : 0;


  if (volume >= 50000) {
    reasons.push("Strong 24H trading activity");
  } else if (volume >= 5000) {
    reasons.push("Trading activity detected");
  } else if (volume < 5000 && totalTrades < 100) {
    reasons.push("Low trading activity");
  }


  if (totalTrades >= 1000) {
    reasons.push("Active trading participation");
  }


  if (holderCount >= 500) {
    reasons.push("Growing holder base");
  } else if (holderCount >= 100) {
    reasons.push("Holder activity detected");
  } else if (holderCount < 50) {
    reasons.push("Limited holder distribution");
  }


  if (tokenAge) {
    if (tokenAge.includes("h")) {
      reasons.push("Fresh launch signal");
    } else if (tokenAge.includes("d")) {
      const days = parseInt(tokenAge);

      if (days <= 7) {
        reasons.push("Early discovery phase");
      } else if (days <= 21) {
        reasons.push("Emerging token");
      }
    } else if (tokenAge.includes("mo")) {
      reasons.push("Established token age");
    }
  }


  if (buyPressure >= 60) {
    reasons.push("Positive buy pressure");
  }


  if (reasons.length === 0) {
    reasons.push("Limited signals available");
  }


  return reasons.slice(0, 4);
}
