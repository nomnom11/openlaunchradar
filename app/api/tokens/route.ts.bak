import { NextResponse } from "next/server";

export const dynamic = "force-dynamic";
const BASE = process.env.OPENLAUNCH_API_BASE || "https://openlaunch.lol";
const CHAINS = ["base", "robinhood", "arc"] as const;

async function getChain(chain: string) {
  const url = `${BASE}/api/launch/list?chain=${chain}&sort=live&window=24h&limit=50`;
  const response = await fetch(url, { cache: "no-store", signal: AbortSignal.timeout(10000), headers: { accept: "application/json" } });
  if (!response.ok) throw new Error(`OpenLaunch API ${chain}: HTTP ${response.status}`);
  const payload = await response.json();
  // The API response may be an array or an object wrapping the list.
  const rows = Array.isArray(payload) ? payload :
    payload?.launches ?? payload?.tokens ?? payload?.items ?? payload?.data ?? [];
  if (!Array.isArray(rows)) throw new Error(`Unrecognized token list format for ${chain}.`);
  return rows.filter((row: any) => row && typeof row === "object" && !Array.isArray(row)).map((row: any) => ({ ...row, chain: row.chain || chain }));
}

export async function GET() {
  const results = await Promise.allSettled(CHAINS.map(getChain));
  const tokens = results.flatMap((result) => result.status === "fulfilled" ? result.value : []);
  const errors = results.flatMap((result, index) =>
    result.status === "rejected" ? [`${CHAINS[index]}: ${String(result.reason?.message || result.reason)}`] : []
  );
  if (!tokens.length) {
    return NextResponse.json({
      tokens: [],
      errors: errors.length ? errors : ["OpenLaunch returned no token data."],
      source: `${BASE}/api/launch/list`,
      fetchedAt: new Date().toISOString()
    }, { status: 502 });
  }
  return NextResponse.json({
    tokens,
    errors,
    source: `${BASE}/api/launch/list`,
    fetchedAt: new Date().toISOString()
  });
}
